 570:hardware/lora/src/LoRa.c ****     /* 1. Hardware reset */
 571:hardware/lora/src/LoRa.c ****     LoRa_reset(_LoRa);
 572:hardware/lora/src/LoRa.c **** 
 573:hardware/lora/src/LoRa.c ****     /* 2. Go to Sleep so we can set LongRangeMode bit */
 574:hardware/lora/src/LoRa.c ****     LoRa_gotoMode(_LoRa, LORA_MODE_SLEEP);
 575:hardware/lora/src/LoRa.c ****     HAL_Delay(10);
 576:hardware/lora/src/LoRa.c **** 
 577:hardware/lora/src/LoRa.c ****     /* 3. Enable LoRa mode (LongRangeMode = 1) */
 578:hardware/lora/src/LoRa.c ****     read = LoRa_read(_LoRa, REG_OP_MODE);
 579:hardware/lora/src/LoRa.c ****     data = read | 0x80U;
 580:hardware/lora/src/LoRa.c ****     LoRa_write(_LoRa, REG_OP_MODE, data);
 581:hardware/lora/src/LoRa.c ****     HAL_Delay(100);
 582:hardware/lora/src/LoRa.c **** 
