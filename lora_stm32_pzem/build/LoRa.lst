 585:hardware/lora/src/LoRa.c **** 
 586:hardware/lora/src/LoRa.c ****     /* 5. Output power */
 587:hardware/lora/src/LoRa.c ****     LoRa_setPower(_LoRa, _LoRa->power);
 588:hardware/lora/src/LoRa.c **** 
 589:hardware/lora/src/LoRa.c ****     /* 6. Over-current protection */
 590:hardware/lora/src/LoRa.c ****     LoRa_setOCP(_LoRa, _LoRa->overCurrentProtection);
 591:hardware/lora/src/LoRa.c **** 
 592:hardware/lora/src/LoRa.c ****     /* 7. LNA gain (max gain + boost) */
 593:hardware/lora/src/LoRa.c ****     LoRa_write(_LoRa, REG_LNA, 0x23);
 594:hardware/lora/src/LoRa.c **** 
 595:hardware/lora/src/LoRa.c ****     /* 8. CRC on + symbol timeout MSB */
 596:hardware/lora/src/LoRa.c ****     LoRa_setTOMsb_setCRCon(_LoRa);
 597:hardware/lora/src/LoRa.c **** 
 598:hardware/lora/src/LoRa.c ****     /* 9. Spreading Factor (+ auto LDO) */
 599:hardware/lora/src/LoRa.c ****     LoRa_setSpreadingFactor(_LoRa, _LoRa->spreadingFactor);
 600:hardware/lora/src/LoRa.c **** 
 601:hardware/lora/src/LoRa.c ****     /* 10. Symbol timeout LSB */
 602:hardware/lora/src/LoRa.c ****     LoRa_write(_LoRa, REG_SYMB_TIMEOUT_LSB, 0xFF);
 603:hardware/lora/src/LoRa.c **** 
 604:hardware/lora/src/LoRa.c ****     /* 11. Bandwidth + Coding Rate + Explicit Header */
 605:hardware/lora/src/LoRa.c ****     data = (uint8_t)((_LoRa->bandwidth << 4) | (_LoRa->codingRate << 1));
 606:hardware/lora/src/LoRa.c ****     /* bit 0 = 0 → Explicit Header Mode */
 607:hardware/lora/src/LoRa.c ****     LoRa_write(_LoRa, REG_MODEM_CONFIG_1, data);
 608:hardware/lora/src/LoRa.c ****     LoRa_setAutoLDO(_LoRa);
 609:hardware/lora/src/LoRa.c **** 
 610:hardware/lora/src/LoRa.c ****     /* 12. Preamble length */
 611:hardware/lora/src/LoRa.c ****     LoRa_write(_LoRa, REG_PREAMBLE_MSB, (uint8_t)(_LoRa->preamble >> 8));
 612:hardware/lora/src/LoRa.c ****     LoRa_write(_LoRa, REG_PREAMBLE_LSB, (uint8_t)(_LoRa->preamble & 0xFF));
 613:hardware/lora/src/LoRa.c **** 
 614:hardware/lora/src/LoRa.c ****     /* 13. DIO0 → RxDone (for interrupt-driven reception) */
 615:hardware/lora/src/LoRa.c ****     read = LoRa_read(_LoRa, REG_DIO_MAPPING_1);
 616:hardware/lora/src/LoRa.c ****     data = (read & 0x3FU) | 0x00;   /* DIO0 = 00 → RxDone */
 617:hardware/lora/src/LoRa.c ****     LoRa_write(_LoRa, REG_DIO_MAPPING_1, data);
 618:hardware/lora/src/LoRa.c **** 
 619:hardware/lora/src/LoRa.c ****     /* 14. Default private sync word (can be overwritten later) */
 620:hardware/lora/src/LoRa.c ****     LoRa_setSyncWord(_LoRa, 0x12);
 621:hardware/lora/src/LoRa.c **** 
 622:hardware/lora/src/LoRa.c ****     /* 15. Standby */
 623:hardware/lora/src/LoRa.c ****     LoRa_gotoMode(_LoRa, LORA_MODE_STANDBY);
 624:hardware/lora/src/LoRa.c ****     HAL_Delay(10);
 625:hardware/lora/src/LoRa.c **** 
 626:hardware/lora/src/LoRa.c ****     /* 16. Check silicon version (SX127x returns 0x12) */
 627:hardware/lora/src/LoRa.c ****     read = LoRa_read(_LoRa, REG_VERSION);
 628:hardware/lora/src/LoRa.c ****     if (read == 0x12) {
 629:hardware/lora/src/LoRa.c ****         return LORA_OK;
 630:hardware/lora/src/LoRa.c ****     }
 631:hardware/lora/src/LoRa.c **** 
