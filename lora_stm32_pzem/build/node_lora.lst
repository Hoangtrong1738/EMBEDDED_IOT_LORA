 166:software/scr/node_lora.c **** static uint8_t wait_for_ack(uint16_t expected_sequence)
 167:software/scr/node_lora.c **** {
 168:software/scr/node_lora.c ****     uint8_t frame[NODE_RX_BUFFER_SIZE];
 169:software/scr/node_lora.c ****     const TickType_t start = xTaskGetTickCount();
 170:software/scr/node_lora.c ****     const TickType_t timeout = pdMS_TO_TICKS(NODE_ACK_TIMEOUT_MS);
 171:software/scr/node_lora.c ****     LoRa_startReceiving(&node_radio);
 172:software/scr/node_lora.c ****     while ((xTaskGetTickCount() - start) < timeout) {
 173:software/scr/node_lora.c ****         TickType_t elapsed = xTaskGetTickCount() - start;
 174:software/scr/node_lora.c ****         (void)ulTaskNotifyTake(pdTRUE, timeout - elapsed);
 175:software/scr/node_lora.c ****         {
 176:software/scr/node_lora.c ****             const uint8_t length = LoRa_receive(&node_radio, frame, sizeof(frame));
ARM GAS  C:\Users\Admin\AppData\Local\Temp\ccpPwalx.s 			page 13


 177:software/scr/node_lora.c ****             if (length > 0U && process_received_frame(frame, length,
 178:software/scr/node_lora.c ****                                                        expected_sequence)) return 1U;
 179:software/scr/node_lora.c ****         }
 180:software/scr/node_lora.c ****         (void)HAL_IWDG_Refresh(&hiwdg);
 181:software/scr/node_lora.c ****     }
 182:software/scr/node_lora.c ****     return 0U;
 183:software/scr/node_lora.c **** }
