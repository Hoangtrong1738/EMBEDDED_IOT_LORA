  68:software/scr/node_lora.c **** static void update_alarm_led(uint8_t status, uint8_t radio_fault,
  69:software/scr/node_lora.c ****                              uint8_t link_lost,
  70:software/scr/node_lora.c ****                              TickType_t now, TickType_t *last_toggle,
  71:software/scr/node_lora.c ****                              TickType_t *active_interval, uint8_t *led_on)
  72:software/scr/node_lora.c **** {
  73:software/scr/node_lora.c ****     if (link_lost || radio_fault != 0U) {
  74:software/scr/node_lora.c ****         *active_interval = 0U;
  75:software/scr/node_lora.c ****         *led_on = 1U;
  76:software/scr/node_lora.c ****         HAL_GPIO_WritePin(NODE_LED_ALARM_PORT, NODE_LED_ALARM_PIN,
  77:software/scr/node_lora.c ****                           NODE_LED_ACTIVE_STATE);
  78:software/scr/node_lora.c ****         return;
  79:software/scr/node_lora.c ****     }
  80:software/scr/node_lora.c **** 
  81:software/scr/node_lora.c ****     const uint8_t fast_fault = (uint8_t)(
  82:software/scr/node_lora.c ****         (status & (ST_OVER_VOLTAGE | ST_OVER_CURRENT | ST_OVER_POWER |
  83:software/scr/node_lora.c ****                    ST_PZEM_FAIL | ST_WDG_RESET)) != 0U);
  84:software/scr/node_lora.c ****     const uint8_t dht_fault = (uint8_t)(
  85:software/scr/node_lora.c ****         (status & (ST_DHT_FAIL | ST_OVER_TEMP | ST_OVER_HUMIDITY)) != 0U);
  86:software/scr/node_lora.c ****     TickType_t interval = 0U;
  87:software/scr/node_lora.c **** 
  88:software/scr/node_lora.c ****     if (fast_fault) {
  89:software/scr/node_lora.c ****         interval = pdMS_TO_TICKS(NODE_ALARM_FAST_BLINK_MS);
  90:software/scr/node_lora.c ****     } else if (dht_fault) {
  91:software/scr/node_lora.c ****         interval = pdMS_TO_TICKS(NODE_ALARM_DHT_BLINK_MS);
  92:software/scr/node_lora.c ****     }
  93:software/scr/node_lora.c **** 
ARM GAS  C:\Users\Admin\AppData\Local\Temp\cc0Ceh40.s 			page 4


  94:software/scr/node_lora.c ****     if (interval == 0U) {
  95:software/scr/node_lora.c ****         *active_interval = 0U;
  96:software/scr/node_lora.c ****         *led_on = 0U;
  97:software/scr/node_lora.c ****         HAL_GPIO_WritePin(NODE_LED_ALARM_PORT, NODE_LED_ALARM_PIN,
  98:software/scr/node_lora.c ****                           NODE_LED_IDLE_STATE);
  99:software/scr/node_lora.c ****     } else if (interval != *active_interval) {
 100:software/scr/node_lora.c ****         *active_interval = interval;
 101:software/scr/node_lora.c ****         *last_toggle = now;
 102:software/scr/node_lora.c ****         *led_on = 1U;
 103:software/scr/node_lora.c ****         HAL_GPIO_WritePin(NODE_LED_ALARM_PORT, NODE_LED_ALARM_PIN,
 104:software/scr/node_lora.c ****                           NODE_LED_ACTIVE_STATE);
 105:software/scr/node_lora.c ****     } else if ((TickType_t)(now - *last_toggle) >= interval) {
 106:software/scr/node_lora.c ****         *last_toggle = now;
 107:software/scr/node_lora.c ****         *led_on = (uint8_t)!(*led_on);
 108:software/scr/node_lora.c ****         HAL_GPIO_WritePin(NODE_LED_ALARM_PORT, NODE_LED_ALARM_PIN,
 109:software/scr/node_lora.c ****                           *led_on ? NODE_LED_ACTIVE_STATE
 110:software/scr/node_lora.c ****                                   : NODE_LED_IDLE_STATE);
 111:software/scr/node_lora.c ****     }
 112:software/scr/node_lora.c **** }
 113:software/scr/node_lora.c **** 
 114:software/scr/node_lora.c **** static void update_system_led(uint8_t connected, TickType_t now,
 115:software/scr/node_lora.c ****                               TickType_t *last_toggle, uint8_t *led_on,
 116:software/scr/node_lora.c ****                               uint8_t *blink_started)
 117:software/scr/node_lora.c **** {
 118:software/scr/node_lora.c ****     if (connected) {
 119:software/scr/node_lora.c ****         *blink_started = 0U;
 120:software/scr/node_lora.c ****         *led_on = 1U;
 121:software/scr/node_lora.c ****         HAL_GPIO_WritePin(NODE_LED_SYSTEM_PORT, NODE_LED_SYSTEM_PIN,
 122:software/scr/node_lora.c ****                           NODE_LED_ACTIVE_STATE);
 123:software/scr/node_lora.c ****     } else if (*blink_started == 0U) {
 124:software/scr/node_lora.c ****         *blink_started = 1U;
 125:software/scr/node_lora.c ****         *last_toggle = now;
 126:software/scr/node_lora.c ****         *led_on = 1U;
 127:software/scr/node_lora.c ****         HAL_GPIO_WritePin(NODE_LED_SYSTEM_PORT, NODE_LED_SYSTEM_PIN,
 128:software/scr/node_lora.c ****                           NODE_LED_ACTIVE_STATE);
 129:software/scr/node_lora.c ****     } else if ((TickType_t)(now - *last_toggle) >=
 130:software/scr/node_lora.c ****                pdMS_TO_TICKS(NODE_LINK_BLINK_MS)) {
 131:software/scr/node_lora.c ****         *last_toggle = now;
 132:software/scr/node_lora.c ****         *led_on = (uint8_t)!(*led_on);
 133:software/scr/node_lora.c ****         HAL_GPIO_WritePin(NODE_LED_SYSTEM_PORT, NODE_LED_SYSTEM_PIN,
 134:software/scr/node_lora.c ****                           *led_on ? NODE_LED_ACTIVE_STATE
 135:software/scr/node_lora.c ****                                   : NODE_LED_IDLE_STATE);
 136:software/scr/node_lora.c ****     }
 137:software/scr/node_lora.c **** }
