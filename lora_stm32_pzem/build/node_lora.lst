 148:software/scr/node_lora.c **** }
 149:software/scr/node_lora.c **** 
 150:software/scr/node_lora.c **** static uint8_t process_received_frame(const uint8_t *frame, uint8_t length,
 151:software/scr/node_lora.c ****                                       uint16_t expected_ack)
 152:software/scr/node_lora.c **** {
 153:software/scr/node_lora.c ****     if (length == sizeof(ack_t)) {
 154:software/scr/node_lora.c ****         ack_t ack;
 155:software/scr/node_lora.c ****         memcpy(&ack, frame, sizeof(ack));
 156:software/scr/node_lora.c ****         if (ack.magic == PKT_MAGIC && ack.node_id == Node_ID &&
 157:software/scr/node_lora.c ****             ack.seq == expected_ack) return 1U;
 158:software/scr/node_lora.c ****     } else if (length == NODE_CONFIG_FRAME_SIZE) {
 159:software/scr/node_lora.c ****         handle_config(frame, length);
 160:software/scr/node_lora.c ****     } else if (length == NODE_HEARTBEAT_FRAME_SIZE) {
 161:software/scr/node_lora.c ****         handle_heartbeat(frame, length);
 162:software/scr/node_lora.c ****     }
 163:software/scr/node_lora.c ****     return 0U;
 164:software/scr/node_lora.c **** }
