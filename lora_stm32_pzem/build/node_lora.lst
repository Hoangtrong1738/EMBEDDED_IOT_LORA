 121:software/scr/node_lora.c **** 
 122:software/scr/node_lora.c ****     if (!lora_decode_config(frame, length, &command)) return;
 123:software/scr/node_lora.c ****     limits.voltage_limit_v = command.voltage_limit;
 124:software/scr/node_lora.c ****     limits.current_limit_ma = command.current_limit_ma;
 125:software/scr/node_lora.c ****     limits.power_limit_mw = command.power_limit_mw;
 126:software/scr/node_lora.c ****     limits.temperature_limit_c = command.temp_limit;
 127:software/scr/node_lora.c ****     limits.humidity_limit_percent = command.hum_limit;
 128:software/scr/node_lora.c ****     (void)xSemaphoreTake(state_mutex, portMAX_DELAY);
 129:software/scr/node_lora.c ****     node_state_apply_limits(&node_state, &limits);
 130:software/scr/node_lora.c ****     changed = node_state_evaluate(&node_state);
 131:software/scr/node_lora.c ****     (void)xSemaphoreGive(state_mutex);
 132:software/scr/node_lora.c ****     if (changed) queue_telemetry(TX_REASON_STATE_CHANGE);
 133:software/scr/node_lora.c ****     transmit_control(reply, lora_encode_control_reply(reply, sizeof(reply),
 134:software/scr/node_lora.c ****                                                        MSG_NODE_CONFIG_ACK,
 135:software/scr/node_lora.c ****                                                        command.seq,
 136:software/scr/node_lora.c ****                                                        NODE_REPLY_OK));
 137:software/scr/node_lora.c ****     uart_log("Node limits updated\r\n");
 138:software/scr/node_lora.c **** }
