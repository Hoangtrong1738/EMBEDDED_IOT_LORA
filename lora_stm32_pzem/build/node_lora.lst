 185:software/scr/node_lora.c **** static uint8_t send_with_ack(const lora_data_pkt_t *packet)
 186:software/scr/node_lora.c **** {
 187:software/scr/node_lora.c ****     uint8_t attempt;
 188:software/scr/node_lora.c ****     for (attempt = 1U; attempt <= ACK_RETRIES; attempt++) {
 189:software/scr/node_lora.c ****         if (LoRa_transmit(&node_radio, (uint8_t *)packet,
 190:software/scr/node_lora.c ****                           (uint8_t)sizeof(*packet), 1000U) &&
 191:software/scr/node_lora.c ****             wait_for_ack(packet->seq)) return 1U;
 192:software/scr/node_lora.c ****         LoRa_startReceiving(&node_radio);
 193:software/scr/node_lora.c ****     }
 194:software/scr/node_lora.c ****     return 0U;
 195:software/scr/node_lora.c **** }
