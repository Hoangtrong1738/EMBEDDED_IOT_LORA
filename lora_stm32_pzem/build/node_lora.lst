 204:software/scr/node_lora.c ****         (void)xSemaphoreTake(state_mutex, portMAX_DELAY);
 205:software/scr/node_lora.c ****         node_state_update_dht(&node_state, valid, (i16)data.temp, data.hum);
 206:software/scr/node_lora.c ****         (void)xSemaphoreGive(state_mutex);
 207:software/scr/node_lora.c ****         xTaskNotifyGive(monitor_task_handle);
 208:software/scr/node_lora.c ****         vTaskDelayUntil(&wake, pdMS_TO_TICKS(NODE_SENSOR_PERIOD_MS));
 209:software/scr/node_lora.c ****     }
 210:software/scr/node_lora.c **** }
