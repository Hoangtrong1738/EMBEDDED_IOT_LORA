 140:software/scr/node_lora.c **** static void handle_heartbeat(const uint8_t *frame, uint8_t length)
 141:software/scr/node_lora.c **** {
 142:software/scr/node_lora.c ****     node_heartbeat_t heartbeat;
 143:software/scr/node_lora.c ****     uint8_t reply[NODE_HEARTBEAT_FRAME_SIZE];
